# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Full step-by-step issuance guide: docs/API_KEYS.md

# --- Meta / Instagram Business Discovery ---------------------------------
# A long-lived Page access token from a Facebook App with the
# instagram_basic + pages_read_engagement permissions. Used to read PUBLIC
# metrics of competitor business/creator accounts via Business Discovery.
META_ACCESS_TOKEN=

# --- YouTube Data API v3 -------------------------------------------------
# An API key from a Google Cloud project with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=

# --- Naver Open API (Search + DataLab) -----------------------------------
# Client ID / Secret from a registered application at developers.naver.com.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Anthropic (optional: LLM creative summaries) ------------------------
# Only needed if analysis.llm.enabled = true in config.yaml.
ANTHROPIC_API_KEY=
